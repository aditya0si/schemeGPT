# Render free-tier API image (512 MB RAM, 0.1 CPU, ~1 GB disk).
#
# Why this is not the main Dockerfile: that one installs PyTorch and bakes the
# fp32 multilingual-e5-small checkpoint, which wants ~1-2 GB of resident memory
# — more than a free instance has. This image runs the SAME model through ONNX
# Runtime instead (fastembed; select it with EMBEDDING_BACKEND, see
# app/config.py), which is a much smaller install and a much smaller process.
#
# The ONNX weights are fetched at BUILD time on purpose: a cold instance must
# not spend its first request downloading them from the Hugging Face Hub, and
# the instance filesystem is ephemeral.
#
# Which export, and why it is the 118 MB one: the fp32 graph (onnx/model.onnx,
# 470 MB) costs about that much resident memory once the ONNX session maps it,
# and the free instance was OOM-killed at its 512 MiB limit on the first query
# that needed the model (Render event log: server_failed, oomKilled 512Mi;
# its baseline without the model is ~98 MB). The int8 graph
# (onnx/model_qint8_avx512_vnni.onnx) keeps the same model, pooling and width —
# only the weights are quantized — and the retrieval gate scores identically on
# the hosted corpus: hit@4 0.875 / mrr@4 0.802083 over four runs in separate
# processes, two of them querying with the int8 graph against fp32 corpus
# vectors (mean cosine to fp32 over 60 real chunks: 0.989).
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # This image IS the ONNX one: keep the backend explicit so it cannot be
    # forgotten at the service level and silently load PyTorch.
    EMBEDDING_BACKEND=fastembed \
    # Read the baked weights from an image path, not the ephemeral home cache.
    FASTEMBED_CACHE_PATH=/app/.fastembed \
    # The quantized graph: this is what makes the model fit a 512 MiB instance.
    # app/embeddings.py reads this before registering the model, so the build
    # warm step below downloads exactly the file the runtime will load.
    EMBEDDING_MODEL_FILE=onnx/model_qint8_avx512_vnni.onnx

COPY requirements-render.txt ./
RUN pip install --no-cache-dir -r requirements-render.txt

COPY app ./app

# Warm the ONNX model cache into FASTEMBED_CACHE_PATH at build time. This goes
# through the application's own loader on purpose: multilingual-e5-small is not
# one of fastembed's built-in models, and app.embeddings registers its pooling
# recipe before downloading the weights.
RUN python -c "\
from app.embeddings import FastEmbedEmbeddings; \
FastEmbedEmbeddings('intfloat/multilingual-e5-small').embed_query('warm the ONNX cache')"

COPY data ./data

EXPOSE 8000

CMD ["sh","-c","uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
