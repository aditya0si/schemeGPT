# Groq API key (free tier). Get one at https://console.groq.com
# OPTIONAL for the demo: leave blank (or set an invalid/expired key) and the
# /query endpoint returns a clearly-labelled pre-made demo answer instead of
# calling Groq.
# REQUIRED for live RAG answers and for RAGAS evaluation.
GROQ_API_KEY=

# Database URL.
# Docker Compose: host "db" (internal network).
# Local dev: use "localhost" instead of "db".
DATABASE_URL=postgresql+psycopg2://scheme:scheme@db:5432/schemegpt
# DATABASE_URL=postgresql+psycopg2://scheme:scheme@localhost:5432/schemegpt

# Optional overrides (defaults shown)
EMBEDDING_MODEL=all-MiniLM-L6-v2
GROQ_MODEL=llama-3.3-70b-versatile
DATA_DIR=data/schemes

# Admin token for POST /ingest (sent as the X-Admin-Token header).
# OPTIONAL but RECOMMENDED for local/dev use: leave blank to DISABLE manual
# re-ingestion (the endpoint returns 503 "disabled"). Startup auto-ingestion
# is unchanged and still runs when the vector store is empty.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=

# Comma-separated browser origins allowed by CORS (defaults shown).
# The Streamlit UI calls the API server-side, so browser CORS only matters for
# direct browser access to the API (e.g. the /docs page).
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Streamlit demo: backend API URL
# STREAMLIT_API_URL=http://localhost:8000
