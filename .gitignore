.env
__pycache__/
.venv/
data/.cache/
.playwright-mcp/

# Evaluation outputs (eval/results/):
#   - report.md is the publishable Markdown report and IS tracked.
#   - *.json / *.csv / history.jsonl are transient machine-readable artifacts
#     that change on every run and are intentionally NOT tracked.
eval/results/*.json
eval/results/*.csv
eval/results/history.jsonl
data/feedback.jsonl

# Field kit runtime state (deploy/field/): logs and deploy records ARE tracked
# as engagement evidence (see docs/FIELD-DEPLOY.md); snapshots and images are not.
deploy/field/logs/
deploy/field/state/
deploy/field/backups/
deploy/field/bundles/
var/

# Editor / scratch
.zed/
